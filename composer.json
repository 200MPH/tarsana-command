{
  "name": "tarsana/command",
  "description": "A framework to build command line applications and share them with the world",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Amine Ben hammou",
      "email": "webneat@gmail.com"
    },
    {
      "name": "Wojtek Brozyna",
      "email": "wojciech.brozyna@gmail.com",
      "role": "Maintainer (fork)"
    }
  ],
  "autoload": {
    "psr-4": {
      "Tarsana\\Command\\": "src",
      "Tarsana\\Tester\\": "tester",
      "Tarsana\\Command\\Tests\\": "tests",
      "Tarsana\\Command\\Examples\\": "examples"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "rector/rector": "^2.2"
  },
  "require": {
    "php": "^8.3",
    "tarsana/io": "^2.0",
    "tarsana/syntax": "^2.0",
    "twig/twig": "^3.0"
  },
  "scripts": {
    "run-tests": "vendor/bin/phpunit --display-deprecations --display-phpunit-deprecations",
    "code-sniff": "vendor/bin/phpcs -d memory_limit=512M -p src tests examples tester --standard=PSR12",
    "code-fix": "vendor/bin/phpcbf -d memory_limit=512M -p src tests examples tester --standard=PSR12",
    "rector": "vendor/bin/rector process"
  }
}
